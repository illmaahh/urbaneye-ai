# Point DNS for this domain to the public server running Docker Compose.
DOMAIN=urbaneye.example.org

# Generate a long random value and share it only with the person creating the first admin account.
URBANEYE_ADMIN_INVITE=replace-with-a-long-random-secret

# Must exactly match the HTTPS URL users open.
PUBLIC_ORIGIN=https://urbaneye.example.org

SESSION_HOURS=24
